NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/express_mongo_auth

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
# Comma-separated list of trusted origins (credentials allowed). Unset = no cross-origin access.
# "*" allows any origin but WITHOUT credentials (cookies won't be sent).
CORS_ORIGIN=http://localhost:3000

# SameSite for the refresh-token cookie: strict | lax | none.
# Use "none" only when the frontend is on a different site; it forces Secure (HTTPS).
COOKIE_SAMESITE=strict
