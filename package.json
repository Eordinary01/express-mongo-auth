{
  "name": "express-mongo-auth",
  "version": "1.0.0",
  "private": true,
  "description": "User authentication & role-based authorization with Express, MongoDB and JWT, plus a demo client",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "lint": "eslint .",
    "create-admin": "npm run create-admin -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
